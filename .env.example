# Compose interpolation. Copy to `.env` (gitignored) and adjust:
#
#   cp .env.example .env
#
# Docker Compose auto-loads `.env` from this directory and substitutes these
# into docker-compose.yml AND the included backend/compose.yaml.
#
# These are consumed by the compose FILE, not injected into containers. Compose
# passes them on where a service needs them (postgres creates this role,
# database connects as it) — which is exactly why they live here rather than in
# a per-service env file: two services have to agree on the same value.
#
# Secrets the application code reads go in `backend.env` instead.

# Postgres credentials. Note these are baked into the pgdata volume the FIRST
# time it initialises — changing them later needs `docker compose down -v`.
PG_USER=eesoc
PG_PASS=eesoc
PG_DB=eesoc
