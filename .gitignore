# Secrets and local config. `*.env` covers .env, backend.env and frontend.env;
# `.env*` additionally covers the dot-prefixed variants (.env.local,
# .env.production). The committed templates end in .example so they are
# unaffected.
*.env
.env*
!*.env.example
!.env.example

# Local Python venv
env/
.venv/
.ocrvenv/

# Python bytecode — 46 of these would otherwise be committed.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node / Vite
node_modules
dist
dist-ssr
.vite
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
.idea/
*.swp

# Session and credential artifacts a test or debug run can drop in the tree —
# a storage state or HAR holds live cookies, so none of these is committable.
session.json
*passkey*.json
*.har

# Output of the test suites (pytest + Playwright). The .auth/ storage state is
# the signed-in sessions the e2e setup mints; the rest are Playwright's report,
# trace and blob directories. See tests/README.md.
tests/e2e/.auth/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Scratch: the scraped copy of eesoc.com used to build the resource seed.
# The seed itself (backend/api/seed/resources_seed.json) IS committed.
/eesoc/

# Source deck for the committee cards — a 9 MB bundled artifact with every
# photo embedded. The content it carried now lives in the database.
EESoc Committee Cards*.html
