# Backend secrets — values the application code reads at runtime.
# Copy to `backend.env` (gitignored) and fill in:
#
#   cp backend.env.example backend.env
#
# Pulled into the api and union containers via `env_file:` in
# backend/compose.yaml. Contrast with `.env.example`, which configures compose
# itself, and with the `environment:` blocks in backend/compose.yaml, which hold
# service wiring (PG_HOST, DATABASE_ADAPTER_URL) that is a property of the
# compose network rather than of the deployment.

# Imperial College Union API. Used by the union bridge service.
# Centre code for EESoc. 603 is what your HTTPie calls used; 625 is Robotics.
ICU_CENTRE_CODE=603
ICU_API_KEY=replace-me
# Upstream is rate limited: excessive requests earn a 5-minute IP ban.
ICU_CACHE_TTL=3600
ICU_MIN_INTERVAL=2

# SMTP. Production values live in the cluster ConfigMap and eesoc-secrets; the
# defaults in config.py are Imperial's webmaster mailbox on Exchange Online
# (smtp.office365.com:587, STARTTLS, LOGIN auth) taken from the 2023/24 handover.
#
# Locally, point at a mail catcher instead so nothing reaches a real inbox:
#   docker run -d -p 8025:8025 -p 1025:1025 axllent/mailpit
# then open http://localhost:8025
#
# Leaving SMTP_HOST blank is also fine — login codes are written to the api log.
#
# To send through the real mailbox from here, set SMTP_HOST=smtp.office365.com,
# SMTP_PORT=587, SMTP_USER=eesocweb@ic.ac.uk, SMTP_STARTTLS=true and put the
# password in SMTP_PASS, then check it with `python3 scripts/check-smtp.py`.
# A username with no password counts as unconfigured, so a half-filled file
# falls back to logging codes rather than failing every send.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_STARTTLS=false
SMTP_FROM=EESoc Webmaster <eesocweb@ic.ac.uk>
SMTP_REPLY_TO=eesoc@imperial.ac.uk

# --- publicity mailbox: newsletters and announcements ------------------------
#
# Anything sent to a list rather than to one person goes from here instead of
# the webmaster mailbox. Two reasons, both practical: a newsletter that invites
# replies should reach the publicity officer, and bulk traffic that earns spam
# complaints must not be able to take sign-in codes down with it.
#
# Every field falls back to its SMTP_* counterpart when blank, so leaving this
# whole block empty simply sends bulk mail from the webmaster address.
#
# PUB_SMTP_PASS is the one worth understanding. A *shared* Exchange mailbox has
# a disabled sign-in account and no password of its own, so no password will
# ever authenticate. The arrangement that does work is to leave PUB_SMTP_USER
# and PUB_SMTP_PASS blank: the app then logs in as the webmaster account and
# still sends From the publicity address — which Exchange permits only if ICT
# has granted that account Send As on the mailbox. If it has not, the send is
# refused, logged loudly, and retried once from the webmaster address so the
# message still arrives.
#
# Check with:  python3 scripts/check-smtp.py --pub
PUB_SMTP_USER=
PUB_SMTP_PASS=
PUB_SMTP_FROM=EESoc Publicity Officer <eesocpub@ic.ac.uk>
PUB_SMTP_REPLY_TO=eesoc@imperial.ac.uk
# Blank inherits the webmaster settings. Only set these if the publicity
# mailbox is on a different server.
# PUB_SMTP_HOST=
# PUB_SMTP_PORT=
# PUB_SMTP_STARTTLS=

# Signs the unsubscribe links in bulk email, so one works from a mail client
# with no session and cannot be forged for somebody else's address. Any long
# random string; generate one with `openssl rand -hex 32`.
#
# Blank falls back to SMTP_PASS, which works but means every unsubscribe link
# already sent stops verifying when the mailbox password is reset — which
# Imperial forces annually. Set it explicitly in production.
EMAIL_TOKEN_SECRET=

# Who is emailed when the site writes a bulk email that needs approving (the
# "tickets are on sale" announcement waits in Admin → Email until somebody
# sends it). Comma separated; blank emails nobody and the admin dashboard is
# the only sign.
EMAIL_APPROVAL_NOTIFY=

# How fast bulk mail goes out. Exchange Online throttles a mailbox at roughly
# 30 messages a minute, and being throttled mid-send looks exactly like the
# mail being rejected, so the default leaves plenty of room.
# BULK_SEND_INTERVAL_SECONDS=2.0
# A refusal threshold, not a target: a society newsletter is in the hundreds.
# BULK_MAX_RECIPIENTS=5000

# Automated booking reminders. The "last chance" email goes out this many hours
# before a hold lapses (holds end at midnight), and never sooner than the second
# setting after the booking was made.
# PURCHASE_REMINDER_HOURS_BEFORE=6
# PURCHASE_REMINDER_MIN_AGE_HOURS=2
# The reminder pass runs hourly on the hour; "tickets are on sale" goes at its
# approved time. Neither is configurable here.

# Uploads. `local` writes to MEDIA_ROOT and nginx serves it off the compose
# volume — that is the development default and needs no bucket. Production uses
# `s3`; see deploy/README.md.
MEDIA_BACKEND=local
# S3_BUCKET=eesoc-media
# S3_ENDPOINT_URL=http://minio:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=
