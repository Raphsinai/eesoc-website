# Backend secrets — values the application code reads at runtime.
# Copy to `backend.env` (gitignored) and fill in:
#
#   cp backend.env.example backend.env
#
# Pulled into the api and union containers via `env_file:` in
# backend/compose.yaml. Contrast with `.env.example`, which configures compose
# itself, and with the `environment:` blocks in backend/compose.yaml, which hold
# service wiring (PG_HOST, DATABASE_ADAPTER_URL) that is a property of the
# compose network rather than of the deployment.

# Imperial College Union API. Used by the union bridge service.
# Centre code for EESoc. 603 is what your HTTPie calls used; 625 is Robotics.
ICU_CENTRE_CODE=603
ICU_API_KEY=replace-me
# Upstream is rate limited: excessive requests earn a 5-minute IP ban.
ICU_CACHE_TTL=3600
ICU_MIN_INTERVAL=2

# SMTP. Production values live in the cluster ConfigMap and eesoc-secrets; the
# defaults in config.py are Imperial's webmaster mailbox on Exchange Online
# (smtp.office365.com:587, STARTTLS, LOGIN auth) taken from the 2023/24 handover.
#
# Locally, point at a mail catcher instead so nothing reaches a real inbox:
#   docker run -d -p 8025:8025 -p 1025:1025 axllent/mailpit
# then open http://localhost:8025
#
# Leaving SMTP_HOST blank is also fine — login codes are written to the api log.
#
# To send through the real mailbox from here, set SMTP_HOST=smtp.office365.com,
# SMTP_PORT=587, SMTP_USER=eesocweb@ic.ac.uk, SMTP_STARTTLS=true and put the
# password in SMTP_PASS, then check it with `python3 scripts/check-smtp.py`.
# A username with no password counts as unconfigured, so a half-filled file
# falls back to logging codes rather than failing every send.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_STARTTLS=false
SMTP_FROM=EESoc Webmaster <eesocweb@ic.ac.uk>
SMTP_REPLY_TO=eesoc@imperial.ac.uk

# Uploads. `local` writes to MEDIA_ROOT and nginx serves it off the compose
# volume — that is the development default and needs no bucket. Production uses
# `s3`; see deploy/README.md.
MEDIA_BACKEND=local
# S3_BUCKET=eesoc-media
# S3_ENDPOINT_URL=http://minio:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=
